# ==============================================================================
# 1. USTAWIENIA MINIO / S3
# ==============================================================================
S3_ENDPOINT=http://127.0.0.1:9000
AWS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# Optional S3-specific override when the AWS CA bundle should differ.
# S3_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
S3_AKID=minioadmin
S3_SK=minioadmin
S3_REGION=us-east-1
S3_BUCKET=test-bucket

# ==============================================================================
# 2. BAZA WEKTOROWA (QDRANT)
# ==============================================================================
QDRANT_API=http://localhost:6333
QDRANT_API_KEY=

# ==============================================================================
# 3. EMBEDDINGS (LM STUDIO / OPENAI)
# ==============================================================================
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=lm-studio
EMBEDDING_BASE_URL=http://192.168.50.127:1234/v1/embeddings
EMBEDDING_MODEL=Qwen3-Embedding-8B
EMBEDDING_DIM=4096
EMBEDDING_MAX_RETRIES=3
EMBEDDING_DELAY=1.0
EMBEDDING_BATCH_SIZE=16

# ==============================================================================
# 4. CZAT (LM STUDIO - AGENT)
# ==============================================================================
CHAT_PROVIDER=local
CHAT_API_KEY=lm-studio
CHAT_BASE_URL=http://192.168.50.127:1234/v1
CHAT_MODEL=gemma-4-31b

# ==============================================================================
# 5. CONFLUENCE x
# ==============================================================================
CONFLUENCE_URL=https://twoja-firma.atlassian.net
CONFLUENCE_USERNAME=twoj-email@firma.com
CONFLUENCE_API_TOKEN=twoj-token-api
CONFLUENCE_MAX_CHARS=2000

# ==============================================================================
# 6. Atlassian MCP
# ==============================================================================
ATLASSIAN_MCP_URL=http://localhost:9002/mcp/
INTERNAL_MCP_URL=http://localhost:8011/mcp

# ==============================================================================
# 7. Langfuse
# ==============================================================================
LANGFUSE_PUBLIC_KEY=lf_pk_1234567890
LANGFUSE_SECRET_KEY=lf_sk_1234567890
LANGFUSE_BASE_URL=http://localhost:3000

# ==============================================================================
# 8. A2A Agent
# ==============================================================================
A2A_AGENT_HOST=host.docker.internal

# ==============================================================================
# 9. Custom Overrides
# ==============================================================================
DEFAULT_HEADERS={"None": "None"}


# ==============================================================================
# 10. RAG MCP
# ==============================================================================
VECTOR_AMOUNT_RAG=50
# Optional override for the generic MCP tool description exposed to the agent.
# KNOWLEDGE_BASE_RAG_TOOL_DESCRIPTION=Retrieve chunks from the selected collection and return them with metadata.
ISO20022_BUSINESS_COLLECTION_NAME=iso20022_business
ISO20022_TECHNICAL_COLLECTION_NAME=iso20022_technical
ISO20022_MESSAGE_SCHEMAS_COLLECTION_NAME=iso20022_message_schemas
SYSTEM_DOCUMENTATION_COLLECTION_NAME=system_docs

# ==============================================================================
# 11. Metrics (metryki działają cały czas - brak flagi włączającej)
# ==============================================================================
# Typ storage: postgres | file
METRICS_STORAGE_TYPE=postgres

# === POSTGRES CONFIG ===
METRICS_DB_HOST=localhost
METRICS_DB_PORT=5432
METRICS_DB_NAME=rag_metrics
METRICS_DB_USER=postgres
METRICS_DB_PASSWORD=postgres_metrics_password
METRICS_DB_POOL_MIN=1
METRICS_DB_POOL_MAX=10

# === FILE CONFIG ===
RAG_METRICS_FILE=rag_metrics.jsonl

# ==============================================================================
# 12. CZAT (LM STUDIO - AGENT)
# ==============================================================================
LLM_PROVIDER=local
LLM_API_KEY=lm-studio
LLM_BASE_URL=http://192.168.50.127:1234/v1
LLM_MODEL=gemma-4-31b



# --- MANUAL METRICS DATA SOURCE (experiments E1-E4) ---
# Active profile: config/dev.yaml
#   data_source.type: s3 | data_s3_source.input_path: General_markdown
# (bucket is not part of the profile yaml - set it here, per environment)
#MANUAL_METRICS_SOURCE=s3
MANUAL_METRICS_SOURCE=local
MANUAL_METRICS_S3_BUCKET=mojsuperbucket
MANUAL_METRICS_S3_PREFIX=test_markdown
# NOTE: dev.yaml says "General_markdown" (capital G) but the real S3 keys
# are lowercase - the prefix must match the keys exactly (S3 is case-sensitive).
#
# Alternative profile: config/default.yaml (local source):
#   data_source.type: local | local_input_path: buissnes_agent/inputs
# MANUAL_METRICS_SOURCE=local
# (dataset_path is then taken from config/experiments.yaml)

# ==============================================================================
# 13. COST (token pricing - USD per 1M tokens, sekcja metryk kosztowych)
# ==============================================================================
# Koszty zapisywane do tabeli rag_cost_metrics (model + sekcja + tokens).
# Gdy model nie zwraca usage, tokeny sa ESTYMOWANE (chars/4) i wiersz ma
# metadata.estimated=true; koszt jest zawsze liczony z tych cen.
COST_INPUT_PER_MTOKEN=0.2
COST_OUTPUT_PER_MTOKEN=0.3
