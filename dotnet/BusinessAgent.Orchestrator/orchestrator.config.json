{
  "agent_card": {
    "name": "System research Agent",
    "description": "Helps with deep research and system analysis.",
    "version": "1.0.0",
    "provider": {
      "organization": "Business Agent"
    },
    "capabilities": {
      "streaming": true,
      "push_notifications": false
    },
    "default_input_modes": [
      "text"
    ],
    "default_output_modes": [
      "text",
      "task-status"
    ],
    "skills": [
      {
        "id": "system_analysis",
        "name": "System Analysis Tool",
        "description": "Helps with system analysis and research tasks.",
        "tags": [
          "system-analysis",
          "research"
        ],
        "examples": [
          "What is system analysis?"
        ],
        "input_modes": [
          "text"
        ],
        "output_modes": [
          "text",
          "task-status"
        ]
      }
    ]
  },  
  "config": {
    "temperature": 0,
    "a2a_agents": [
      {
        "name": "system_research",
        "url": "${DEEP_RESEARCH_AGENT_URL:-http://dockge.home.arpa:10004}",
        "transport": "JSONRPC"
      },
      {
        "name": "business_research",
        "url": "${DEEP_RESEARCH_AGENT_URL:-http://localhost:10004}",
        "transport": "JSONRPC"
      }
    ],
    "mcp_servers": [
      {
        "name": "knowledge_base",
        "transport": "streamable_http",
        "url": "${INTERNAL_MCP_URL:-http://dockge.home.arpa:8012/mcp}"
      },
      {
        "name": "atlassian",
        "transport": "streamable_http",
        "url": "${ATLASSIAN_MCP_URL:-http://dockge.home.arpa:9002/mcp}",
        "blocked_tools": [
          "confluence_update_page",
          "confluence_delete_page",
          "confluence_delete_attachment"
        ]
      }
    ]
  }
